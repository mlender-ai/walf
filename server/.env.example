# 로컬 개발·QA용 예시. 운영 배포 시 반드시 바꾸세요.
WALF_PORT=4300
# 어드민 비밀번호 — 12자 이상으로 바꿔 쓰세요(.env는 저장소에 올라가지 않는다)
WALF_ADMIN_PASSWORD=change-me
WALF_DB=data/walf.db
# QA 도구(일정 당기기·즉시 종료). 운영에서는 0
WALF_QA_TOOLS=1
# 1이면 Expo 푸시 발송을 시도하지 않음
WALF_PUSH_DISABLED=0
# AI 보조(접수 즉시 AI가 먼저 식별·국내 판매처 탐색 → 운영자 검수). 키가 없으면 꺼지고 운영자가 직접 확인한다.
# 키는 https://console.anthropic.com 에서 직접 발급해 넣으세요(.env는 저장소에 올라가지 않는다).
ANTHROPIC_API_KEY=
WALF_AI_MODEL=claude-opus-5-5
WALF_AI_EFFORT=high
# off: 끔 · mock: 모의 AI(QA 전용, 실제 분석 없음, 결과는 모두 “모의” 표시)
WALF_AI_PROVIDER=

# ── 비용 가드레일(V2) ── 유료 AI 호출 전에 확인한다. 모의(mock) 실행은 집계하지 않는다
# 이번 달(KST) 추정 비용 상한(USD). 넘길 작업은 “보류”되고 어드민 비용 화면에서 운영자가 확인해야 계속된다
WALF_AI_MONTHLY_BUDGET_USD=10
# 의뢰 하나에 쓸 수 있는 유료 AI 호출 수(식별·다시 식별·하루 탐색 포함)
WALF_AI_MAX_CALLS_PER_REQUEST=10
# 모델 단가가 바뀌면 덮어쓴다(USD / 100만 토큰). 비우면 코드의 공식 단가표(2026-11-13 확인)를 쓴다
WALF_AI_PRICE_IN=
WALF_AI_PRICE_OUT=

# ── 기다려줘(V2) ── 가격 확인은 AI를 부르지 않는다
WALF_WATCH_MAX_ACTIVE=3
WALF_WATCH_CHECK_HOURS=24
WALF_WATCH_RENEW_DAYS=30
WALF_WATCH_UNREACHABLE_AFTER=3
WALF_WATCH_POLL_MS=10000
# 1이면 테스트 가격 소스(mock://fixture/…)를 쓸 수 있다. WALF_QA_TOOLS=1 이거나 WALF_AI_PROVIDER=mock 이면 자동으로 켜진다. 운영에서는 끈다
WALF_MOCK_SOURCES=0
# 스키마를 올리기 전 DB 사본을 남길 곳
WALF_BACKUPS=data/backups
